__pycache__/
*.pyc
.DS_Store
data/
*sessions/
notes.txt
*.log
.venv/
venv/

# Real stimulus clips (FilmStim etc.) are large, copyrighted commercial film
# files -- never belong in git. Keep them in assets/clips/ locally/on Drive
# and point emotion_manifest.json at that path; only placeholders are tracked.
assets/clips/
*.mp4
*.mpg
*.mov
*.avi
*.webm

# OpenMATB (attention task engine) is a separate open-source project, run as
# a subprocess -- vendored as an external, unmodified checkout, not part of
# this repo's history. See README.md "Attention task (OpenMATB)".
vendor/OpenMATB/
